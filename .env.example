# Site URL for absolute links in emails
NEXT_PUBLIC_SITE_URL="https://klingende-kirche.de"

# -----------------------------------------------------------------------------
# Neon (Postgres)
# -----------------------------------------------------------------------------
# Connection string, e.g. postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://..."

# -----------------------------------------------------------------------------
# Resend (transactional mail)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
MAIL_FROM="Klingende Kirche <tickets@klingende-kirche.de>"
MAIL_REPLY_TO="info@klingende-kirche.de"

# Empfänger der Bestell-Benachrichtigungen (an den Verantwortlichen im Verein,
# der die Bestellungen abarbeitet). Wenn leer, geht die Mail hart kodiert an
# info@klingende-kirche.de.
ORDER_NOTIFICATION_EMAIL="info@klingende-kirche.de"

# -----------------------------------------------------------------------------
# Admin dashboard
# -----------------------------------------------------------------------------
# Plain password for /admin login. Keep this strong and rotate regularly.
ADMIN_PASSWORD="change-me-please"

# Secret used to sign the admin session cookie (any random string >= 32 chars).
ADMIN_SESSION_SECRET="generate-with-openssl-rand-base64-48"

# -----------------------------------------------------------------------------
# Vercel Blob (for concert image uploads)
# -----------------------------------------------------------------------------
# In the Vercel dashboard: Storage → Create → Blob store → Connect to project.
# A BLOB_READ_WRITE_TOKEN env var is injected automatically there; set it
# manually locally if you want to test uploads from `next dev`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
